# 复制为 .env 后填写。切勿把真实 key 提交进仓库。
# 参考 docs/项目实现文档-阶段0.md §6.1

# ---- 数据库 ----
# 阶段 0 用 SQLite 即可跑通；阶段 4 做 pgvector 前必须切到 PostgreSQL。
DATABASE_URL=sqlite+aiosqlite:///./kb.db
# PostgreSQL（需先起服务，见 README）：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_base

# ---- JWT ----
# PyJWT 对 <32 字节密钥会告警；请随机生成 32 字节以上字符串
JWT_SECRET=please-change-me-to-a-random-32byte-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- LLM（OpenAI 兼容协议，换厂商只改这几项） ----
LLM_BASE_URL=https://api.deepseek.com
# ⚠️ 这里只能放占位符！.env.example 会提交进仓库，真实 key 必须写在 .env（已被 .gitignore 忽略）
#    申请地址：https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1024

# ---- 思考模式（DeepSeek 专有）----
# 实测同一 RAG 问答 prompt：开启 completion=187(思考 151) 1733ms ≈0.00188元
#                          关闭 completion=36            703ms ≈0.00049元，答案同样正确
# RAG 是"从资料提取总结"，推理已在检索阶段完成，故默认 false。
# 注意：思考模式下 temperature 会被静默忽略。
LLM_THINKING=false
LLM_REASONING_EFFORT=low

# ---- RAG 参数（阶段 4 调优的起点） ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=6000

# ---- 阶段 1：Redis 缓存 + 多级限流（见 docs/项目实现文档-阶段1.md） ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_SOCKET_TIMEOUT=1.0

# 答案缓存（同问题 + 同检索结果 → 免一次 LLM 调用）
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_KEY_PREFIX=kb

# L1 每用户频率（滑动窗口，次/分）
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
# L2 全局并发 LLM 数（分布式信号量）
LLM_MAX_CONCURRENCY=10
# L3 每用户每日 LLM 调用配额（成本熔断）
DAILY_LLM_QUOTA=200
# Redis 故障时的策略：true=放行（可用性优先）；false=拒绝（成本优先）
RATELIMIT_FAIL_OPEN=true

# ---- 阶段 2：会话记忆 + 流式输出（见 docs/项目实现文档-阶段2.md） ----
# 滑动窗口轮数（1 轮 = user + assistant），影响发给 LLM 的历史长度与缓存指纹
SESSION_WINDOW_TURNS=6
# 流式默认不重试：一旦有 chunk 推出就不能重试（§5.2）
LLM_STREAM_MAX_RETRIES=1
# 缓存命中时答案切块推送的大小（字/块）
STREAM_CACHED_CHUNK_CHARS=24

# ---- 阶段 4：向量检索 + 混合检索 + rerank + 查询改写（见 docs/项目实现文档-阶段4.md） ----
# ★ 三个下载相关变量缺一不可（§1.3）：
#   HF_ENDPOINT 走国内镜像；HF_HUB_DISABLE_XET 禁用 Xet 后端（否则镜像上 401）；
#   EMBEDDING_CACHE_DIR 持久化模型（否则落系统临时目录，重启重下）。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
EMBEDDING_CACHE_DIR=.model_cache

# Embedding（本地 fastembed，零成本零 API key）
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# 混合召回 / RRF / 最终条数
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
FINAL_TOP_K=5

# Rerank（本地 bge-reranker-base，约 1GB 内存代价）
# ★ §1.1 实测：小语料下 rerank 几乎没有提升，内存吃紧可直接置 false（白拿回 801MB）。
# ★ 默认关闭：自有语料实测 Top-1 +6% / Top-5 +0%（docs/项目实现文档-阶段4.md §15.6）
#   开启会让 web 进程 RSS 从 363MB 涨到 1164MB。语料变大后再开并复测。
RERANK_ENABLED=false
RERANK_TOP_K=10

# 多轮查询改写
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_HISTORY_TURNS=3
QUERY_REWRITE_CACHE_TTL=3600

# ---- 日志（阶段 4 补）----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- 可观测 Langfuse（阶段 6）----
# ★ 默认关：没账号也能跑全部测试；关闭时所有 trace 退化为 no-op。
#   开启需去 https://cloud.langfuse.com 注册（免费）建 project 拿两个 key。
#   注意：开启后问题/切片/回答会发往外部，敏感文档请改自托管。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 评测（阶段 6）----
# 裁判模型留空则复用 LLM_MODEL（DeepSeek 自己当裁判，不引入新厂商）。
EVAL_CASES_PATH=app/evals/qa_cases.yaml
EVAL_JUDGE_MODEL=
EVAL_JUDGE_TEMPERATURE=0.0
